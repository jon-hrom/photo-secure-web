{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Missing image on detect",
      "method": "POST",
      "path": "/?action=detect",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Invalid action",
      "method": "POST",
      "path": "/?action=bogus",
      "body": {"image": "aGVsbG8="},
      "expectedStatus": 400
    },
    {
      "name": "Estimate simple background is free",
      "method": "POST",
      "path": "/?action=estimate",
      "body": {"stats": {"mask_ratio": 0.004, "ring_std": 8, "skin_ratio": 0.01}},
      "expectedStatus": 200
    },
    {
      "name": "Estimate logo on person",
      "method": "POST",
      "path": "/?action=estimate",
      "body": {"stats": {"mask_ratio": 0.03, "ring_std": 30, "skin_ratio": 0.5, "face_hint": true}},
      "expectedStatus": 200
    },
    {
      "name": "Inpaint without mask",
      "method": "POST",
      "path": "/?action=inpaint",
      "body": {"image": "aGVsbG8="},
      "expectedStatus": 400
    }
  ]
}