{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Missing image on detect",
      "method": "POST",
      "path": "/?action=detect",
      "body": {"ping": 1},
      "expectedStatus": 400
    },
    {
      "name": "Invalid action",
      "method": "POST",
      "path": "/?action=bogus",
      "body": {"image": "aGVsbG8="},
      "expectedStatus": 400
    },
    {
      "name": "Estimate returns fixed price",
      "method": "POST",
      "path": "/?action=estimate",
      "body": {"ping": 1},
      "expectedStatus": 200,
      "expectedBody": {"price": 25, "tier": "ai"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Inpaint without mask",
      "method": "POST",
      "path": "/?action=inpaint",
      "body": {"image": "aGVsbG8="},
      "expectedStatus": 400
    },
    {
      "name": "Inpaint without user id",
      "method": "POST",
      "path": "/?action=inpaint",
      "body": {"image": "aGVsbG8=", "mask": "aGVsbG8="},
      "expectedStatus": 401
    },
    {
      "name": "Status without task id",
      "method": "POST",
      "path": "/?action=status",
      "body": {"ping": 1},
      "expectedStatus": 400
    }
  ]
}